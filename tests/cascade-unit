#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
PYTHONPATH="$repo_root/scripts/lib" python3 - <<'PY'
from cascade import (
    ENDPOINT_POLICY, EventValidator, NEMOTRON_ALIAS, PARAKEET_ALIAS,
    assemble_transcript,
)


def common(sequence, kind, position, **extra):
    return {
        "schema_version": 1, "session_id": "unit", "sequence": sequence,
        "event": kind, "emitted_monotonic_seconds": sequence / 100,
        "audio_position_seconds": position, **extra,
    }


def endpoint(position, automatic=False, last_token=None, crossing=None, decoder=None):
    return {
        "schema_version": 1, "automatic_endpoint": automatic,
        "decoder_clock_seconds": decoder,
        "last_token_seconds": last_token,
        "logical_threshold_crossing_seconds": crossing,
        "raw_delivery_frontier_seconds": position,
        "event_delivery_position_seconds": position,
        "delivery_lag_seconds": position - crossing if automatic else None,
    }


validator = EventValidator("unit")
validator.accept(common(
    1, "session_started", 0, models=[NEMOTRON_ALIAS, PARAKEET_ALIAS],
    chunk_milliseconds=20,
    endpointing=ENDPOINT_POLICY, paced=False,
))
validator.accept(common(
    2, "transcript_update", 0.5, segment_id="segment-000001", track_id="nemotron",
    revision=1, state="provisional", text="draft",
    source_time={"start_seconds": 0.0, "end_seconds": 0.5}, model_alias=NEMOTRON_ALIAS,
))
validator.accept(common(
    3, "transcript_update", 1.0, segment_id="segment-000001", track_id="nemotron",
    revision=2, state="segment_final", text="upstream",
    source_time={"start_seconds": 0.0, "end_seconds": 1.0}, model_alias=NEMOTRON_ALIAS,
    endpoint_diagnostics=endpoint(1.0),
    words=[{"word": "upstream", "start_seconds": 0.1, "end_seconds": 0.8}],
))
validator.accept(common(
    4, "transcript_update", 1.0, segment_id="segment-000001", track_id="authoritative",
    revision=1, state="cascade_final", text="accurate",
    source_time={"start_seconds": 0.0, "end_seconds": 1.0}, model_alias=PARAKEET_ALIAS,
    selection="parakeet", supersedes={"track_id": "nemotron", "revision": 2},
    endpoint_diagnostics=endpoint(1.0),
    words=[{"word": "accurate", "start_seconds": 0.2, "end_seconds": 0.9}],
))
assert assemble_transcript(validator.segments) == "accurate"

# Identical consecutive partials are malformed and do not consume a revision.
duplicate = EventValidator("unit")
duplicate.accept(common(
    1, "session_started", 0, models=[NEMOTRON_ALIAS, PARAKEET_ALIAS],
    chunk_milliseconds=20,
    endpointing=ENDPOINT_POLICY, paced=False,
))
partial = common(
    2, "transcript_update", 0.2, segment_id="segment-000001", track_id="nemotron",
    revision=1, state="provisional", text="same",
    source_time={"start_seconds": 0.0, "end_seconds": 0.2}, model_alias=NEMOTRON_ALIAS,
)
duplicate.accept(partial)
try:
    duplicate.accept({**partial, "sequence": 3, "revision": 2, "audio_position_seconds": 0.4,
                      "source_time": {"start_seconds": 0.0, "end_seconds": 0.4}})
except ValueError as error:
    assert "identical" in str(error)
else:
    raise AssertionError("duplicate partial accepted")

# Selection semantics are explicit: fallback equals Nemotron and silence is empty.
fallback = EventValidator("unit")
fallback.accept(common(
    1, "session_started", 0, models=[NEMOTRON_ALIAS, PARAKEET_ALIAS],
    chunk_milliseconds=20,
    endpointing=ENDPOINT_POLICY, paced=True,
))
fallback.accept(common(
    2, "transcript_update", 1, segment_id="segment-000001", track_id="nemotron",
    revision=1, state="segment_final", text="fallback",
    source_time={"start_seconds": 0.0, "end_seconds": 1.0}, model_alias=NEMOTRON_ALIAS,
    endpoint_diagnostics=endpoint(1.0),
))
fallback.accept(common(
    3, "session_warning", 1, code="pass_two_empty", message="empty",
))
fallback.accept(common(
    4, "transcript_update", 1, segment_id="segment-000001", track_id="authoritative",
    revision=1, state="cascade_final", text="fallback",
    source_time={"start_seconds": 0.0, "end_seconds": 1.0}, model_alias=NEMOTRON_ALIAS,
    selection="nemotron_fallback", supersedes={"track_id": "nemotron", "revision": 1},
    endpoint_diagnostics=endpoint(1.0),
))
assert fallback.segments[0]["authoritative"]["selection"] == "nemotron_fallback"

# Timestamp offsets are enforced against exact endpointed source ranges.
bad_time = {**common(
    5, "transcript_update", 2, segment_id="segment-000002", track_id="nemotron",
    revision=1, state="segment_final", text="second",
    source_time={"start_seconds": 1.0, "end_seconds": 2.0}, model_alias=NEMOTRON_ALIAS,
    endpoint_diagnostics=endpoint(2.0),
    words=[{"word": "second", "start_seconds": 0.98, "end_seconds": 1.4}],
)}
fallback.accept(bad_time)
bad_authoritative = common(
    6, "transcript_update", 2, segment_id="segment-000002", track_id="authoritative",
    revision=1, state="cascade_final", text="accurate",
    source_time={"start_seconds": 1.0, "end_seconds": 2.0}, model_alias=PARAKEET_ALIAS,
    selection="parakeet", supersedes={"track_id": "nemotron", "revision": 1},
    endpoint_diagnostics=endpoint(2.0),
    words=[{"word": "bad", "start_seconds": 0.1, "end_seconds": 0.2}],
)
try:
    fallback.accept(bad_authoritative)
except ValueError as error:
    assert "outside" in str(error)
else:
    raise AssertionError("unoffset second-segment word accepted")

# Bounds-disabled Nemotron words remain nonnegative and truly ordered.
try:
    EventValidator._words({"words": [
        {"word": "later", "start_seconds": 1.2, "end_seconds": 1.3},
        {"word": "backward", "start_seconds": 1.1, "end_seconds": 1.2},
    ]}, 1.0, 2.0, enforce_segment_bounds=False)
except ValueError as error:
    assert "monotonic" in str(error)
else:
    raise AssertionError("backward Nemotron word order accepted")

# A genuinely absent last-token clock remains nullable while the other
# automatic-endpoint clocks retain their ordering contract.
EventValidator._endpoint_diagnostics({
    "audio_position_seconds": 1.3,
    "endpoint_diagnostics": endpoint(
        1.3, automatic=True, last_token=None, crossing=1.2, decoder=1.28,
    ),
}, 1.2)

try:
    EventValidator._endpoint_diagnostics({
        "audio_position_seconds": 1.3,
        "endpoint_diagnostics": {
            **endpoint(1.3, automatic=True, crossing=1.2, decoder=1.28),
            "delivery_lag_seconds": 0.4,
        },
    }, 1.2)
except ValueError as error:
    assert "delivery lag" in str(error)
else:
    raise AssertionError("inconsistent endpoint delivery lag accepted")

try:
    EventValidator._endpoint_diagnostics({
        "audio_position_seconds": 1.3,
        "endpoint_diagnostics": endpoint(
            1.3, automatic=True, last_token=0.0, crossing=1.2, decoder=1.28,
        ),
    }, 1.3)
except ValueError as error:
    assert "source boundary" in str(error)
else:
    raise AssertionError("automatic diagnostic disagreed with its rounded source boundary")

# A delivered-late automatic final retains its logical source range. Warnings
# use the delivery clock, fallback remains explicit, and EOF closes the exact
# contiguous partition.
late = EventValidator("late")
late.accept({**common(
    1, "session_started", 0, models=[NEMOTRON_ALIAS, PARAKEET_ALIAS],
    chunk_milliseconds=20, endpointing=ENDPOINT_POLICY, paced=False,
), "session_id": "late"})
late_diagnostic = endpoint(
    1.5, automatic=True, last_token=0.2, crossing=1.4, decoder=1.45,
)
late.accept({**common(
    2, "transcript_update", 1.5, segment_id="segment-000001", track_id="nemotron",
    revision=1, state="segment_final", text="fallback",
    source_time={"start_seconds": 0.0, "end_seconds": 1.4}, model_alias=NEMOTRON_ALIAS,
    endpoint_diagnostics=late_diagnostic,
), "session_id": "late"})
late.accept({**common(
    3, "session_warning", 1.5, code="pass_two_empty", message="empty",
), "session_id": "late"})
late.accept({**common(
    4, "transcript_update", 1.5, segment_id="segment-000001", track_id="authoritative",
    revision=1, state="cascade_final", text="fallback",
    source_time={"start_seconds": 0.0, "end_seconds": 1.4}, model_alias=NEMOTRON_ALIAS,
    selection="nemotron_fallback", supersedes={"track_id": "nemotron", "revision": 1},
    endpoint_diagnostics=late_diagnostic,
), "session_id": "late"})
eof_diagnostic = endpoint(3.5)
late.accept({**common(
    5, "transcript_update", 3.5, segment_id="segment-000002", track_id="nemotron",
    revision=1, state="segment_final", text="tail",
    source_time={"start_seconds": 1.4, "end_seconds": 3.5}, model_alias=NEMOTRON_ALIAS,
    endpoint_diagnostics=eof_diagnostic,
), "session_id": "late"})
late.accept({**common(
    6, "transcript_update", 3.5, segment_id="segment-000002", track_id="authoritative",
    revision=1, state="cascade_final", text="accurate tail", model_alias=PARAKEET_ALIAS,
    source_time={"start_seconds": 1.4, "end_seconds": 3.5}, selection="parakeet",
    supersedes={"track_id": "nemotron", "revision": 1}, endpoint_diagnostics=eof_diagnostic,
), "session_id": "late"})
late.accept({**common(
    7, "session_metrics", 3.5,
    model_load_counts={NEMOTRON_ALIAS: 1, PARAKEET_ALIAS: 1},
    timing={"inference_seconds": 1.0}, counts={
        "segments": 2, "provisional_updates": 0, "parakeet_segments": 1,
        "nemotron_fallbacks": 1, "silence_segments": 0, "warnings": 1,
    },
), "session_id": "late"})
assert [segment["source_time"] for segment in late.segments] == [
    {"start_seconds": 0.0, "end_seconds": 1.4},
    {"start_seconds": 1.4, "end_seconds": 3.5},
]

try:
    late.accept({**common(
        8, "session_warning", 3.4, code="late_warning", message="backwards",
    ), "session_id": "late"})
except ValueError as error:
    assert "audio position moved backwards" in str(error)
else:
    raise AssertionError("warning delivery clock moved backwards")

incomplete = EventValidator("incomplete")
incomplete.accept({**common(
    1, "session_started", 0, models=[NEMOTRON_ALIAS, PARAKEET_ALIAS],
    chunk_milliseconds=20, endpointing=ENDPOINT_POLICY, paced=False,
), "session_id": "incomplete"})
incomplete.accept({**common(
    2, "transcript_update", 1.5, segment_id="segment-000001", track_id="nemotron",
    revision=1, state="segment_final", text="short",
    source_time={"start_seconds": 0.0, "end_seconds": 1.4}, model_alias=NEMOTRON_ALIAS,
    endpoint_diagnostics=late_diagnostic,
), "session_id": "incomplete"})
incomplete.accept({**common(
    3, "transcript_update", 1.5, segment_id="segment-000001", track_id="authoritative",
    revision=1, state="cascade_final", text="short", model_alias=PARAKEET_ALIAS,
    source_time={"start_seconds": 0.0, "end_seconds": 1.4}, selection="parakeet",
    supersedes={"track_id": "nemotron", "revision": 1}, endpoint_diagnostics=late_diagnostic,
), "session_id": "incomplete"})
try:
    incomplete.accept({**common(
        4, "session_metrics", 1.5,
        model_load_counts={NEMOTRON_ALIAS: 1, PARAKEET_ALIAS: 1},
        timing={"inference_seconds": 1.0}, counts={
            "segments": 1, "provisional_updates": 0, "parakeet_segments": 1,
            "nemotron_fallbacks": 0, "silence_segments": 0, "warnings": 0,
        },
    ), "session_id": "incomplete"})
except ValueError as error:
    assert "partition" in str(error)
else:
    raise AssertionError("incomplete final PCM partition accepted")

# Schema 1 fixes the endpoint policy at 1,200 ms.
old_policy = EventValidator("unit")
try:
    old_policy.accept(common(
        1, "session_started", 0, models=[NEMOTRON_ALIAS, PARAKEET_ALIAS],
        chunk_milliseconds=20,
        endpointing={"kind": "token_silence", "silence_milliseconds": 800}, paced=False,
    ))
except ValueError as error:
    assert "endpoint policy" in str(error)
else:
    raise AssertionError("old endpoint policy accepted")

print("cascade unit tests: ok")
PY
