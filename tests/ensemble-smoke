#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/native-asr-ensemble-test.XXXXXX")
trap 'rm -rf -- "$work"' EXIT

models=$work/models
manifest=$work/models.lock
mkdir -p "$models/nemo-speech" "$models/sherpa-onnx" "$models/whisper-cpp" \
  "$models/llama-cpp/ministral-3b-instruct-2512"
: > "$models/nemo-speech/model.gguf"
: > "$models/sherpa-onnx/model.onnx"
: > "$models/whisper-cpp/model.bin"
: > "$models/llama-cpp/ministral-3b-instruct-2512/model.gguf"
: > "$work/input.wav"
cat > "$manifest" <<'EOF'
nemo-test|nemo:parakeet-tdt-v3|nemo-speech|Test NeMo|https://invalid.example/nemo|test-nemo|model.gguf|nemo-speech/model.gguf|e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855|CC-BY-4.0|file||test
sherpa-test|sherpa:parakeet-unified-en|sherpa-onnx|Test Sherpa|https://invalid.example/sherpa|test-sherpa|model.onnx|sherpa-onnx/model.onnx|e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855|CC-BY-4.0|file||test
whisper-test|whisper:small.en|whisper-cpp|Test Whisper|https://invalid.example/whisper|test-whisper|model.bin|whisper-cpp/model.bin|e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855|MIT|file||test
llama-test|llm:ministral-3b-instruct-2512|llama-cpp|Test LLM|https://invalid.example/llm|test-llm|model.gguf|llama-cpp/ministral-3b-instruct-2512/model.gguf|e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855|Apache-2.0|file||test
EOF

export PATH="$repo_root/tests/fixtures/ensemble-bin:$PATH"
export NATIVE_ASR_CONTAINER_ENGINE=docker
export NATIVE_ASR_MODELS=$models
export NATIVE_ASR_MODEL_MANIFEST=$manifest
export NATIVE_ASR_TEST_DOCKER_LOG=$work/docker.log

bundle=$work/default-bundle
stdout=$("$repo_root/scripts/ensemble" --output "$bundle" "$work/input.wav" 2> "$work/default.stderr")
[[ $stdout == 'Hello, brave world.' ]]
jq -e '
  .schema_version == 2
  and .status == "complete"
  and .text == "Hello, brave world."
  and .consensus_text == .text
  and .adjudication.status == "disabled"
  and [.models[].alias] == ["nemo:parakeet-tdt-v3","sherpa:parakeet-unified-en","whisper:small.en"]
  and .models[0].anchor
  and (.models | all(.status == "complete"))
  and (.models | all(.container.image_id | startswith("sha256:test-")))
  and (.provenance.git_revision | length == 40)
  and (.provenance.adapter_sha256 | length == 64)
  and .decision_counts.primary_fallback == 1
' "$bundle/result.json" >/dev/null
[[ $(< "$bundle/transcript.txt") == 'Hello, brave world.' ]]
[[ $(< "$bundle/consensus.txt") == 'Hello, brave world.' ]]
jq -e '.status == "disabled" and .model == null and (.spans | length == 0)' \
  "$bundle/adjudication.json" >/dev/null
jq -e '.status == "complete" and (.columns | length == 3)' "$bundle/alignment.json" >/dev/null
jq -e '.status == "complete" and (.spans | length == 1)' "$bundle/disagreements.json" >/dev/null
for track in "$bundle"/tracks/*.json; do
  jq -e '.status == "complete" and (.runtime_result.text | length > 0)
    and (.normalized_tokens | length > 0)' "$track" >/dev/null
done
grep -Fq 'fake diagnostic: completed' "$bundle/logs/01-nemo-parakeet-tdt-v3.stderr.log"

# Publication is invisible until all tracks are complete.
atomic=$work/atomic-bundle
export NATIVE_ASR_TEST_DELAY_IMAGE=asr-sherpa-onnx
export NATIVE_ASR_TEST_DELAY_SECONDS=0.5
export NATIVE_ASR_TEST_STARTED=$work/atomic.started
"$repo_root/scripts/ensemble" --output "$atomic" "$work/input.wav" \
  > "$work/atomic.stdout" 2> "$work/atomic.stderr" &
atomic_pid=$!
for _ in $(seq 1 100); do [[ -e $NATIVE_ASR_TEST_STARTED ]] && break; sleep 0.02; done
[[ -e $NATIVE_ASR_TEST_STARTED ]]
[[ ! -e $atomic ]]
wait "$atomic_pid"
[[ -f $atomic/result.json ]]
unset NATIVE_ASR_TEST_DELAY_IMAGE NATIVE_ASR_TEST_DELAY_SECONDS NATIVE_ASR_TEST_STARTED

# Explicit model order controls both the anchor and display-form preference.
ordered=$work/ordered-bundle
ordered_stdout=$("$repo_root/scripts/ensemble" --output "$ordered" \
  --model whisper:small.en --model nemo:parakeet-tdt-v3 \
  --model sherpa:parakeet-unified-en "$work/input.wav" 2> "$work/ordered.stderr")
[[ $ordered_stdout == 'Hello, bold world!' ]]
jq -e '.models[0].alias == "whisper:small.en" and .models[0].anchor
  and .models[1].alias == "nemo:parakeet-tdt-v3"' "$ordered/result.json" >/dev/null

# A valid bounded deletion becomes authoritative while consensus is preserved.
adjudicated=$work/adjudicated-bundle
adjudicated_stdout=$("$repo_root/scripts/ensemble" --output "$adjudicated" \
  --adjudicator llm:ministral-3b-instruct-2512 "$work/input.wav" \
  2> "$work/adjudicated.stderr")
[[ $adjudicated_stdout == 'Hello, world.' ]]
[[ $(< "$adjudicated/transcript.txt") == 'Hello, world.' ]]
[[ $(< "$adjudicated/consensus.txt") == 'Hello, brave world.' ]]
jq -e '
  .status == "complete"
  and .text == "Hello, world."
  and .consensus_text == "Hello, brave world."
  and .adjudication.status == "complete"
  and .adjudication.counts.applied == 1
  and .adjudication.execution.load_seconds == 0.25
  and .artifacts.adjudication == "adjudication.json"
  and .artifacts.consensus == "consensus.txt"
' "$adjudicated/result.json" >/dev/null
jq -e '
  .status == "complete"
  and .policy_id == "primary-fallback-only-v1"
  and .model.alias == "llm:ministral-3b-instruct-2512"
  and .runtime.revision == "08659901c43b51de735740f1cf61bb82fbe0c4e4"
  and .runtime.policy.network == "none"
  and .runtime.policy.adjudication_policy_id == "primary-fallback-only-v1"
  and .counts.eligible_tie_columns == 1
  and .counts.protected_majority_columns == 0
  and (.spans[0].prompt.input.columns[0].candidates | length == 3)
  and .spans[0].validated_choices[0].candidate.value == null
  and .execution.peak_rss_kb == 6000
' "$adjudicated/adjudication.json" >/dev/null
grep -Fq -- '--network none' "$NATIVE_ASR_TEST_DOCKER_LOG"
grep -Fq -- '--read-only' "$NATIVE_ASR_TEST_DOCKER_LOG"
grep -Fq -- '--interactive' "$NATIVE_ASR_TEST_DOCKER_LOG"
grep -Fq -- '--user ' "$NATIVE_ASR_TEST_DOCKER_LOG"
grep -Fq -- '--cap-drop ALL' "$NATIVE_ASR_TEST_DOCKER_LOG"
grep -Fq -- '--security-opt no-new-privileges' "$NATIVE_ASR_TEST_DOCKER_LOG"
grep -Fq -- '--tmpfs /tmp:rw,noexec,nosuid,nodev,size=256m' \
  "$NATIVE_ASR_TEST_DOCKER_LOG"
grep -Fq -- "source=$models/llama-cpp/ministral-3b-instruct-2512,target=/models,readonly" \
  "$NATIVE_ASR_TEST_DOCKER_LOG"
if grep 'asr-llama-cpp' "$NATIVE_ASR_TEST_DOCKER_LOG" | \
    grep -Fq "source=$models/llama-cpp,target=/models"; then
  printf '%s\n' 'adjudicator unexpectedly received the complete LLM model root' >&2
  exit 1
fi
if grep 'asr-llama-cpp' "$NATIVE_ASR_TEST_DOCKER_LOG" | grep -Fq '/audio'; then
  printf '%s\n' 'adjudicator unexpectedly received an audio mount' >&2
  exit 1
fi

# Abstention is valid and leaves the deterministic result byte-for-byte intact.
abstained=$work/abstained-bundle
export NATIVE_ASR_TEST_ADJUDICATOR_MODE=abstain
"$repo_root/scripts/ensemble" --output "$abstained" \
  --adjudicator llm:ministral-3b-instruct-2512 "$work/input.wav" \
  > "$work/abstained.stdout" 2> "$work/abstained.stderr"
unset NATIVE_ASR_TEST_ADJUDICATOR_MODE
jq -e '.text == .consensus_text and .adjudication.status == "complete"
  and .adjudication.counts.abstained == 1' "$abstained/result.json" >/dev/null

# Every malformed response shape falls back atomically and still exits zero.
for mode in malformed malformed-content duplicate missing invalid-index; do
  fallback_bundle=$work/fallback-$mode
  export NATIVE_ASR_TEST_ADJUDICATOR_MODE=$mode
  "$repo_root/scripts/ensemble" --output "$fallback_bundle" \
    --adjudicator llm:ministral-3b-instruct-2512 "$work/input.wav" \
    > "$work/fallback-$mode.stdout" 2> "$work/fallback-$mode.stderr"
  jq -e '.status == "complete" and .text == .consensus_text
    and .adjudication.status == "fallback"
    and .adjudication.counts.fallback == 1' "$fallback_bundle/result.json" >/dev/null
  grep -Fq 'warning: adjudication fallback' "$work/fallback-$mode.stderr"
done
unset NATIVE_ASR_TEST_ADJUDICATOR_MODE

# Valid earlier spans survive a later invalid response; the bad span is consensus.
partial=$work/partial-bundle
export NATIVE_ASR_TEST_TWO_SPANS=1 NATIVE_ASR_TEST_ADJUDICATOR_MODE=partial
partial_stdout=$("$repo_root/scripts/ensemble" --output "$partial" \
  --adjudicator llm:ministral-3b-instruct-2512 "$work/input.wav" \
  2> "$work/partial.stderr")
unset NATIVE_ASR_TEST_TWO_SPANS NATIVE_ASR_TEST_ADJUDICATOR_MODE
[[ $partial_stdout == 'A DOG X RED Z' ]]
jq -e '.adjudication.status == "partial"
  and .adjudication.counts.spans_validated == 1
  and .adjudication.counts.spans_fallback == 1' "$partial/result.json" >/dev/null

# Timeout, worker crash, startup failure, and unavailable image all preserve consensus.
for mode in timeout crash startup-failure; do
  fallback_bundle=$work/runtime-$mode
  export NATIVE_ASR_TEST_ADJUDICATOR_MODE=$mode
  if [[ $mode == timeout ]]; then
    timeout_args=(--adjudication-timeout 0.05)
  else
    timeout_args=()
  fi
  "$repo_root/scripts/ensemble" --output "$fallback_bundle" \
    --adjudicator llm:ministral-3b-instruct-2512 "${timeout_args[@]}" "$work/input.wav" \
    > "$work/runtime-$mode.stdout" 2> "$work/runtime-$mode.stderr"
  jq -e '.status == "complete" and .text == .consensus_text
    and .adjudication.status == "fallback"' "$fallback_bundle/result.json" >/dev/null
done
unset NATIVE_ASR_TEST_ADJUDICATOR_MODE

unavailable=$work/unavailable-bundle
export NATIVE_ASR_TEST_INSPECT_FAIL_IMAGE=asr-llama-cpp
"$repo_root/scripts/ensemble" --output "$unavailable" \
  --adjudicator llm:ministral-3b-instruct-2512 "$work/input.wav" \
  > "$work/unavailable.stdout" 2> "$work/unavailable.stderr"
unset NATIVE_ASR_TEST_INSPECT_FAIL_IMAGE
jq -e '.status == "complete" and .text == .consensus_text
  and .adjudication.status == "unavailable"' "$unavailable/result.json" >/dev/null

# A boundary conflict rejects the whole tie span with an explicit reason.
boundary=$work/boundary-bundle
export NATIVE_ASR_TEST_BOUNDARY_CONFLICT=1
"$repo_root/scripts/ensemble" --output "$boundary" \
  --adjudicator llm:ministral-3b-instruct-2512 "$work/input.wav" \
  > "$work/boundary.stdout" 2> "$work/boundary.stderr"
unset NATIVE_ASR_TEST_BOUNDARY_CONFLICT
jq -e '.text == .consensus_text and .adjudication.status == "fallback"
  and .adjudication.counts.spans_fallback == 1
  and .adjudication.fallback_code == "boundary_path_conflict"
  and .adjudication.artifact == "adjudication.json"' "$boundary/result.json" >/dev/null
jq -e '.spans[0].fallback_code == "boundary_path_conflict"
  and .spans[0].fallback_reason == "boundary_path_conflict"' \
  "$boundary/adjudication.json" >/dev/null

# Provenance is verified, but ordinary 2-of-3 disagreement with no true tie
# returns not_needed and never starts the worker.
not_needed=$work/not-needed-bundle
export NATIVE_ASR_TEST_MAJORITY_ONLY=1 NATIVE_ASR_TEST_ADJUDICATOR_MODE=startup-failure
"$repo_root/scripts/ensemble" --output "$not_needed" \
  --adjudicator llm:ministral-3b-instruct-2512 "$work/input.wav" \
  > "$work/not-needed.stdout" 2> "$work/not-needed.stderr"
unset NATIVE_ASR_TEST_MAJORITY_ONLY NATIVE_ASR_TEST_ADJUDICATOR_MODE
jq -e '.status == "complete" and .adjudication.status == "not_needed"
  and .adjudication.counts.eligible_tie_columns == 0
  and .adjudication.counts.protected_majority_columns == 1
  and .adjudication.model.artifact.sha256 == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"' \
  "$not_needed/result.json" >/dev/null
! grep -Fq 'starting adjudicator' "$work/not-needed.stderr"

# A started runtime failure publishes evidence but no authoritative transcript.
failed=$work/failed-bundle
export NATIVE_ASR_TEST_FAIL_IMAGE=asr-whisper-cpp
set +e
"$repo_root/scripts/ensemble" --output "$failed" "$work/input.wav" \
  > "$work/failed.stdout" 2> "$work/failed.stderr"
failed_status=$?
set -e
unset NATIVE_ASR_TEST_FAIL_IMAGE
[[ $failed_status == 1 && -d $failed && ! -e $failed/transcript.txt ]]
jq -e '.status == "failed" and .failure.model_alias == "whisper:small.en"
  and .models[0].status == "complete" and .models[2].status == "failed"' \
  "$failed/result.json" >/dev/null
grep -Fq 'forced failure' "$failed/logs/03-whisper-small-en.stderr.log"

# Exit-zero empty output is also a strict started-job failure.
empty=$work/empty-bundle
export NATIVE_ASR_TEST_EMPTY_IMAGE=asr-sherpa-onnx
set +e
"$repo_root/scripts/ensemble" --output "$empty" "$work/input.wav" \
  > "$work/empty.stdout" 2> "$work/empty.stderr"
empty_status=$?
set -e
unset NATIVE_ASR_TEST_EMPTY_IMAGE
[[ $empty_status == 1 && -d $empty && ! -e $empty/transcript.txt ]]
jq -e '.status == "failed" and .failure.model_alias == "sherpa:parakeet-unified-en"
  and (.failure.message | contains("empty"))' "$empty/result.json" >/dev/null

# Existing destinations are validation errors and are never modified.
existing=$work/existing
mkdir "$existing"
printf '%s\n' sentinel > "$existing/keep"
set +e
"$repo_root/scripts/ensemble" --output "$existing" "$work/input.wav" \
  > "$work/existing.stdout" 2> "$work/existing.stderr"
existing_status=$?
set -e
[[ $existing_status == 2 && $(< "$existing/keep") == sentinel ]]

# Cancellation terminates the active process group and publishes a cancelled audit.
cancelled=$work/cancelled-bundle
export NATIVE_ASR_TEST_DELAY_IMAGE=asr-sherpa-onnx
export NATIVE_ASR_TEST_DELAY_SECONDS=30
export NATIVE_ASR_TEST_STARTED=$work/cancelled.started
"$repo_root/scripts/ensemble" --output "$cancelled" "$work/input.wav" \
  > "$work/cancelled.stdout" 2> "$work/cancelled.stderr" &
cancelled_pid=$!
for _ in $(seq 1 100); do [[ -e $NATIVE_ASR_TEST_STARTED ]] && break; sleep 0.02; done
[[ -e $NATIVE_ASR_TEST_STARTED ]]
kill -TERM "$cancelled_pid"
set +e
wait "$cancelled_pid"
cancelled_status=$?
set -e
unset NATIVE_ASR_TEST_DELAY_IMAGE NATIVE_ASR_TEST_DELAY_SECONDS NATIVE_ASR_TEST_STARTED
[[ $cancelled_status == 130 && -d $cancelled && ! -e $cancelled/transcript.txt ]]
jq -e '.status == "cancelled" and .models[0].status == "complete"
  and .models[1].status == "cancelled"' "$cancelled/result.json" >/dev/null

# Cancellation while the LLM is active remains a cancelled job, never fallback success.
adjudication_cancelled=$work/adjudication-cancelled-bundle
export NATIVE_ASR_TEST_ADJUDICATOR_MODE=timeout
export NATIVE_ASR_TEST_DELAY_SECONDS=30
export NATIVE_ASR_TEST_STARTED=$work/adjudication-cancelled.started
"$repo_root/scripts/ensemble" --output "$adjudication_cancelled" \
  --adjudicator llm:ministral-3b-instruct-2512 --adjudication-timeout 60 \
  "$work/input.wav" > "$work/adjudication-cancelled.stdout" \
  2> "$work/adjudication-cancelled.stderr" &
adjudication_cancelled_pid=$!
for _ in $(seq 1 200); do [[ -e $NATIVE_ASR_TEST_STARTED ]] && break; sleep 0.02; done
[[ -e $NATIVE_ASR_TEST_STARTED ]]
kill -TERM "$adjudication_cancelled_pid"
set +e
wait "$adjudication_cancelled_pid"
adjudication_cancelled_status=$?
set -e
unset NATIVE_ASR_TEST_ADJUDICATOR_MODE NATIVE_ASR_TEST_DELAY_SECONDS NATIVE_ASR_TEST_STARTED
[[ $adjudication_cancelled_status == 130 && -d $adjudication_cancelled \
  && ! -e $adjudication_cancelled/transcript.txt ]]
jq -e '.status == "cancelled" and .failure.stage == "adjudication"
  and .consensus_text == "Hello, brave world."
  and (.adjudication.status == "fallback" or .adjudication.status == "partial")' \
  "$adjudication_cancelled/result.json" >/dev/null

# The repeated snapshot runner uses the same persistent protocol and records
# deterministic validated choices even when a fake candidate misses the gate.
benchmark_result=$work/adjudication-benchmark.json
export NATIVE_ASR_TEST_ADJUDICATOR_MODE=abstain
set +e
"$repo_root/scripts/adjudication-benchmark" --output "$benchmark_result" \
  --calibration-snapshot "$repo_root/benchmarks/published/2026-08-09-librispeech-100" \
  --validation-snapshot "$repo_root/benchmarks/published/2026-08-09-librispeech-100" \
  --adjudicator llm:ministral-3b-instruct-2512 --repeats 2 --timeout 1 \
  > "$work/adjudication-benchmark.stdout" 2> "$work/adjudication-benchmark.stderr"
benchmark_status=$?
set -e
unset NATIVE_ASR_TEST_ADJUDICATOR_MODE
((benchmark_status == 0 || benchmark_status == 1))
jq -e '
  .schema_version == 2
  and .policy.id == "primary-fallback-only-v1"
  and .evaluations.calibration.snapshot.utterances == 200
  and .evaluations.calibration.snapshot.eligible_tie_spans == 22
  and .evaluations.calibration.snapshot.eligible_tie_columns == 22
  and .evaluations.calibration.snapshot.protected_majority_columns == 222
  and (.models | length == 1)
  and .models[0].evaluations.calibration.identical_validated_decisions
  and .models[0].evaluations.calibration.validated_spans == [22,22]
  and .models[0].evaluations.calibration.fallback_spans == [0,0]
  and (.models[0].evaluations.validation.repeats | length == 2)
' "$benchmark_result" >/dev/null

# The bundle stays private after atomic rename.
while IFS= read -r mode; do [[ $mode == 700 ]]; done < <(find "$bundle" -type d -printf '%m\n')
while IFS= read -r mode; do [[ $mode == 600 ]]; done < <(find "$bundle" -type f -printf '%m\n')
while IFS= read -r mode; do [[ $mode == 700 ]]; done < <(find "$adjudicated" -type d -printf '%m\n')
while IFS= read -r mode; do [[ $mode == 600 ]]; done < <(find "$adjudicated" -type f -printf '%m\n')

printf '%s\n' 'ensemble integration smoke: ok'
