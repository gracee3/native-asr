#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

PYTHONPATH="$repo_root/scripts/lib" python3 - <<'PY'
import copy

from adjudication_benchmark import summarize_evaluation, summarize_model
from ensemble import (
    ADJUDICATION_POLICY_ID,
    BoundaryPathConflict,
    add_native_timing,
    adjudication_prompt,
    adjudication_spans,
    build_consensus,
    lexical_tokens,
    render_adjudicated,
    validate_adjudication_choices,
    validate_boundary_paths,
)


def track(alias, text, result=None):
    tokens = lexical_tokens(text)
    basis = add_native_timing(result or {"text": text}, tokens)
    return {"model_alias": alias, "timing_basis": basis, "normalized_tokens": tokens}


# Tokenization is exactly the existing English policy, including Unicode apostrophes.
tokens = lexical_tokens(" It’s—fine...  isn't it? ")
assert [token["normalized"] for token in tokens] == ["IT'S", "FINE", "ISN'T", "IT"]
assert [token["surface"] for token in tokens] == ["It’s", "fine", "isn't", "it"]

# Substitution consensus takes both spelling and punctuation from the first supporter.
result = build_consensus([
    track("primary", "Hello, color."),
    track("second", "Hello, colour!"),
    track("third", "Hello, colour?"),
])
assert result["text"] == "Hello, colour!"
assert result["decision_counts"]["majority_token"] == 1

# Insertions and deletions are real confusion-network columns; null is a vote.
inserted = build_consensus([
    track("primary", "A C"), track("second", "A B C"), track("third", "A B C")
])
assert inserted["text"] == "A B C"
assert inserted["decision_counts"]["majority_token"] == 1
deleted = build_consensus([
    track("primary", "A B C"), track("second", "A C"), track("third", "A C")
])
assert deleted["text"] == "A C"
assert deleted["decision_counts"]["majority_deletion"] == 1

# A three-way disagreement falls back to the primary and remains unresolved.
fallback = build_consensus([
    track("primary", "A CAT C"), track("second", "A DOG C"), track("third", "A FOX C")
])
assert fallback["text"] == "A CAT C"
column = next(column for column in fallback["columns"] if column["unresolved"])
assert column["decision"] == "primary_fallback"
assert column["selected"]["model_alias"] == "primary"
assert len(adjudication_spans(fallback)) == 1

# Native word times remain word times; segment spans remain explicitly coarse.
nemo = track("nemo", "one two", {
    "text": "one two",
    "words": [
        {"word": "one", "start": 0.1, "end": 0.4},
        {"word": "two", "start": 0.5, "end": 0.9},
    ],
})
assert nemo["timing_basis"] == "word"
assert nemo["normalized_tokens"][0]["timing"] == {
    "basis": "word", "start_seconds": 0.1, "end_seconds": 0.4, "native_index": 0,
}
sherpa = track("sherpa", "one two", {
    "text": "one two", "segments": [{"text": "one two", "start": 1.0, "end": 2.0}],
})
assert sherpa["timing_basis"] == "segment"
assert all(token["timing"]["basis"] == "segment" for token in sherpa["normalized_tokens"])
whisper = track("whisper", "one two", {
    "text": "one two", "raw": {"transcription": [{
        "text": "one two", "timestamps": {"from": "00:00:03.000", "to": "00:00:04.250"},
    }]},
})
assert whisper["normalized_tokens"][1]["timing"]["end_seconds"] == 4.25
unavailable = track("none", "one", {"text": "one"})
assert unavailable["timing_basis"] == "unavailable"
assert unavailable["normalized_tokens"][0]["timing"] is None

# All disagreements keep their established grouping, while only consecutive
# primary fallbacks form adjudication tasks. The majority column is immutable.
grouped = build_consensus([
    track("primary", "A B C D E"),
    track("second", "A X Y D E"),
    track("third", "A X Z D E"),
])
assert len(grouped["disagreements"]) == 1
span = grouped["disagreements"][0]
assert span["end_column_exclusive"] - span["start_column"] == 2
assert span["context"] == {"before": "A", "after": "D E"}
assert span["unresolved"]
tie_spans = adjudication_spans(grouped)
assert len(tie_spans) == 1
assert tie_spans[0]["start_column"] == span["start_column"] + 1
assert tie_spans[0]["context"] == {"before": "A X", "after": "D E"}

# Adjudication prompts carry exact candidates and accept only one bounded
# decision per disagreement column.
prompt = adjudication_prompt(fallback, fallback["disagreements"][0])
assert prompt["policy_id"] == ADJUDICATION_POLICY_ID
assert prompt["input"]["context"] == {"before_tokens": ["A"], "after_tokens": ["C"]}
assert prompt["input"]["columns"][0]["candidates"] == ["CAT", "DOG", "FOX"]
response = {
    "span_index": 0,
    "decisions": [{"column_index": 1, "candidate_index": 1, "reason": "contextual_fit"}],
}
validated = validate_adjudication_choices(prompt, response)
assert validated[0]["candidate"]["value"]["surface"] == "DOG"
fallback_tracks = [track("primary", "A CAT C"), track("second", "A DOG C"),
                   track("third", "A FOX C")]
assert render_adjudicated(fallback, fallback_tracks, {1: 1}) == "A DOG C"

# A deletion inside a genuine three-way tie is selectable; abstention preserves
# deterministic consensus. A 2-of-3 insertion disagreement is not eligible.
assert adjudication_spans(inserted) == []
deletion_tracks = [track("primary", "A B C"), track("second", "A C"),
                   track("third", "A D C")]
deletion_tie = build_consensus(deletion_tracks)
deletion_span = adjudication_spans(deletion_tie)[0]
deletion_prompt = adjudication_prompt(deletion_tie, deletion_span)
deletion_response = {
    "span_index": 0,
    "decisions": [{"column_index": 1, "candidate_index": 1, "reason": "grammar"}],
}
validate_adjudication_choices(deletion_prompt, deletion_response)
assert render_adjudicated(deletion_tie, deletion_tracks, {1: 1}) == "A C"
abstain_response = {
    "span_index": 0,
    "decisions": [{"column_index": 1, "candidate_index": -1, "reason": "abstain"}],
}
validate_adjudication_choices(deletion_prompt, abstain_response)
assert render_adjudicated(deletion_tie, deletion_tracks, {1: -1}) == deletion_tie["text"]

# Protected normalized majorities retain their deterministic surface form.
surface_tracks = [track("primary", "Hello, color."), track("second", "Hello, colour!"),
                  track("third", "Hello, colour?")]
surface_consensus = build_consensus(surface_tracks)
assert render_adjudicated(surface_consensus, surface_tracks, {}) == "Hello, colour!"

# Prompt construction and rendering independently refuse protected majority
# columns, so an internal caller cannot opt into majority rewriting.
try:
    adjudication_prompt(inserted, inserted["disagreements"][0])
except ValueError as error:
    assert "protected" in str(error)
else:
    raise AssertionError("a majority disagreement became an adjudication prompt")
try:
    render_adjudicated(inserted, [track("primary", "A C"), track("second", "A B C"),
                                  track("third", "A B C")], {1: 0})
except ValueError as error:
    assert "protected" in str(error)
else:
    raise AssertionError("rendering allowed a majority override")

# Explicit edge selections must agree with protected neighboring consensus.
boundary_tracks = [track("primary", "A CAT C"), track("second", "A DOG X"),
                   track("third", "A FOX C")]
boundary = build_consensus(boundary_tracks)
boundary_span = adjudication_spans(boundary)[0]
boundary_prompt = adjudication_prompt(boundary, boundary_span)
boundary_choices = validate_adjudication_choices(boundary_prompt, {
    "span_index": 0,
    "decisions": [{"column_index": 1, "candidate_index": 1, "reason": "grammar"}],
})
try:
    validate_boundary_paths(boundary, boundary_span, boundary_choices)
except BoundaryPathConflict as error:
    assert str(error) == "boundary_path_conflict"
else:
    raise AssertionError("a conflicting protected boundary was accepted")
assert render_adjudicated(boundary, boundary_tracks, {1: 1}) == boundary["text"]

# Duplicate, missing, malformed, out-of-bounds, and inconsistent decisions fail closed.
bad_responses = [
    {"span_index": 0, "decisions": []},
    {"span_index": 7, "decisions": response["decisions"]},
    {"span_index": 0, "decisions": response["decisions"] * 2},
    {"span_index": 0, "decisions": [{"column_index": 1, "candidate_index": 3,
                                       "reason": "grammar"}]},
    {"span_index": 0, "decisions": [{"column_index": 1, "candidate_index": -1,
                                       "reason": "grammar"}]},
    {"span_index": 0, "decisions": [{"column_index": 1, "candidate_index": 1,
                                       "reason": "abstain"}]},
]
for bad in bad_responses:
    try:
        validate_adjudication_choices(prompt, bad)
    except ValueError:
        pass
    else:
        raise AssertionError(f"invalid adjudication was accepted: {bad}")

# Benchmark summaries tolerate a missing forced-shutdown RSS sample and still
# retain the available peak. Two missing samples remain explicitly unavailable.
benchmark_repeat = {
    "repeat": 1,
    "provenance": {"artifact": {}, "container": {}, "runtime": {}, "policy": {}},
    "scores": {
        "librispeech-test-clean": {"errors": 37, "reference_words": 2084},
        "librispeech-test-other": {"errors": 53, "reference_words": 1645},
    },
    "combined_errors": 90,
    "decisions_sha256": "same",
    "decisions": [{"timing": {"wall_seconds": 1.0}}],
    "validated_spans": 22,
    "fallback_spans": 0,
    "execution": {
        "load_seconds": 1.0,
        "prompt_tokens": 10,
        "generated_tokens": 10,
        "prompt_seconds": 1.0,
        "generation_seconds": 1.0,
        "cpu_seconds": 4.0,
        "peak_rss_kb": 1234,
    },
}
benchmark_repeat_2 = copy.deepcopy(benchmark_repeat)
benchmark_repeat_2["repeat"] = 2
benchmark_repeat_2["execution"]["peak_rss_kb"] = None
baseline = {"librispeech-test-clean": 37, "librispeech-test-other": 54}
summary = summarize_evaluation([benchmark_repeat, benchmark_repeat_2], baseline)
assert summary["qualifies"] and summary["metrics"]["peak_rss_kb"] == 1234
benchmark_repeat["execution"]["peak_rss_kb"] = None
summary = summarize_evaluation([benchmark_repeat, benchmark_repeat_2], baseline)
assert summary["metrics"]["peak_rss_kb"] is None
model_summary = summarize_model(
    "test",
    {"calibration": [benchmark_repeat, benchmark_repeat_2],
     "validation": [benchmark_repeat, benchmark_repeat_2]},
    {"calibration": baseline, "validation": baseline},
)
assert model_summary["qualifies"]

print("ensemble unit tests: ok")
PY
