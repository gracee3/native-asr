#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == --version ]]; then
  printf '%s\n' 'nemo-speech 1.0.0'
  exit 0
fi

[[ ${1:-} == transcribe ]]
streaming=false
for arg in "$@"; do
  [[ $arg == --stream ]] && streaming=true
done

if [[ $streaming == true ]]; then
  text='streamed nemo words'
else
  text='offline nemo words'
fi

jq -cn \
  --arg text "$text" \
  '{
    file: "/tmp/fake.wav",
    text: $text,
    confidence: 0.95,
    duration: 1.25,
    languages: ["en"],
    words: [{word: $text, start: 0.0, end: 1.25, confidence: 0.95}]
  }'
