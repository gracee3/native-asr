#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

value() {
  local file=$1 key=$2
  sed -n "s/^ARG ${key}=//p" "$file" | tail -n 1
}

sherpa=$repo_root/docker/sherpa-onnx/Dockerfile
nemo=$repo_root/docker/nemo-speech/Dockerfile
moonshine=$repo_root/docker/moonshine/Dockerfile
whisper=$repo_root/docker/whisper-cpp/Dockerfile
llama=$repo_root/docker/llama-cpp/Dockerfile

printf '%-18s %-12s %s\n' RUNTIME VERSION REVISION
printf '%-18s %-12s %s\n' \
  sherpa-onnx \
  "$(value "$sherpa" SHERPA_ONNX_VERSION)" \
  "$(value "$sherpa" SHERPA_ONNX_REVISION)"
printf '%-18s %-12s %s\n' \
  onnxruntime \
  "$(value "$sherpa" ONNXRUNTIME_VERSION)" \
  bundled-by-sherpa
printf '%-18s %-12s %s\n' \
  nemo-speech \
  "$(value "$nemo" NEMO_SPEECH_VERSION)" \
  "$(value "$nemo" NEMO_SPEECH_REVISION)"
printf '%-18s %-12s %s\n' \
  ggml submodule "$(value "$nemo" GGML_REVISION)"
printf '%-18s %-12s %s\n' \
  moonshine "$(value "$moonshine" MOONSHINE_VERSION)" \
  "$(value "$moonshine" MOONSHINE_REVISION)"
printf '%-18s %-12s %s\n' \
  whisper.cpp "$(value "$whisper" WHISPER_CPP_VERSION)" \
  "$(value "$whisper" WHISPER_CPP_REVISION)"
printf '%-18s %-12s %s\n' \
  llama.cpp "$(value "$llama" LLAMA_CPP_VERSION)" \
  "$(value "$llama" LLAMA_CPP_REVISION)"
