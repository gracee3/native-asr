#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$repo_root"

if ! grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' VERSION ||
   [[ $(wc -l < VERSION) -ne 1 ]]; then
  printf '%s\n' 'error: VERSION must contain one semantic version' >&2
  exit 1
fi

mapfile -t shell_files < <(
  find scripts tests docker -type f \
    ! -name Dockerfile \
    -exec awk 'FNR == 1 && $0 ~ /^#!.*(ba)?sh/ { print FILENAME }' {} +
)
bash -n "${shell_files[@]}"

awk -F'|' '
  BEGIN { ok=1 }
  !/^#/ && NF && NF != 13 {
    print FNR ": expected 13 model-lock fields, got " NF > "/dev/stderr"
    ok=0
  }
  END { exit !ok }
' manifests/models.lock

awk -F'|' '
  BEGIN { ok=1 }
  !/^#/ && NF && NF != 6 {
    print FNR ": expected 6 model-component fields, got " NF > "/dev/stderr"
    ok=0
  }
  END { exit !ok }
' manifests/model-components.lock

awk -F'|' '
  BEGIN { ok=1 }
  !/^#/ && NF && NF != 14 {
    print FNR ": expected 14 dataset-lock fields, got " NF > "/dev/stderr"
    ok=0
  }
  END { exit !ok }
' manifests/datasets.lock

python3 -m py_compile scripts/lib/*.py

(
  cd tui
  cargo fmt -- --check
  cargo clippy --all-targets --locked -- -D warnings
  cargo test --locked
)

./scripts/models list >/dev/null
./tests/sherpa-entrypoint-smoke
./tests/nemo-entrypoint-smoke
./tests/transcribe-smoke
./tests/cascade-smoke
./tests/cascade-wrapper-smoke
./tests/cascade-benchmark-unit
./tests/pipewire-loopback-unit
./tests/usability-smoke
./tests/ensemble-unit
./tests/ensemble-smoke
./tests/ensemble-regression
./tests/benchmark-smoke
./tests/benchmark-runner-smoke
./tests/paths-evaluation-smoke
./tests/foundation-unit

if rg -n -i \
  '(COPY|ADD)[[:space:]].*models|ADD[[:space:]]+https?://|huggingface\.co|releases/download/asr-models|\.(gguf|onnx|nemo|safetensors|pt|pth|bin)([^[:alnum:]_]|$)' \
  docker -g Dockerfile; then
  printf '%s\n' 'error: Dockerfile appears to include a model source or artifact' >&2
  exit 1
fi

while IFS= read -r dockerfile; do
  if sed -n '/^FROM .* AS runtime/,$p' "$dockerfile" | \
      rg -n -i 'python|pip|pytorch|nemo-toolkit'; then
    printf 'error: forbidden framework or Python found in final runtime stage: %s\n' \
      "$dockerfile" >&2
    exit 1
  fi
done < <(find docker -name Dockerfile -type f -print)

git diff --check
printf '%s\n' 'repository checks: ok'
